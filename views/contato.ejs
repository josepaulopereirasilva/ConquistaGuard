<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contato - ConquistaGuard</title>
  <link rel="icon" href="/conquistaguard.ico" type="image/x-icon">
  <link rel="stylesheet" href="/style.css">
  <style>
    .conteudo {
      padding: 60px 20px;
      max-width: 800px;
      margin: 0 auto;
    }

    .conteudo h1 {
      color: #ffcc00;
      font-size: 32px;
      margin-bottom: 20px;
      text-align: left;
      padding-left: 10px;
      /* mesmo padding dos inputs se desejar esse alinhamento */
    }
  </style>
</head>

<body>
  <header>
    <div class="logo" onclick="redirect()" style="cursor: pointer; display: inline-block;">
      <a href="/"><img src="/conquistaguard.ico" alt="ConquistaGuard Logo" style="height: 100px;"></a>
    </div>
    <nav>
      <ul>
        <li><a href="/equipamentos">Equipamentos</a></li>
        <li><a href="/sobre">Sobre</a></li>
        <li><a href="/contato">Contato</a></li>
      </ul>
    </nav>
  </header>

  <main class="conteudo">

    <form action="https://formsubmit.co/jeanphillip399@gmail.com" method="POST">
      <h1 id="faleConosco">Fale Conosco por E-mail:</h1>
      <input type="text" name="name" placeholder="Seu nome" required />
      <input type="email" name="email" placeholder="Seu e-mail" required />
      <textarea name="message" placeholder="Sua mensagem" required></textarea>
      <button type="submit">Enviar</button>
      <br>
      <div id="whatsapp" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <h1 id="tituloWhats">Ou pelo nosso WhatsApp:</h1>
        <a href="https://wa.me/5577988148527" target="_blank"
          style="display:inline-flex; align-items:center; gap:8px; margin-top:15px; text-decoration:none;">
          <img src="/whatsapp.png" alt="WhatsApp" style="width:30px; height:30px;">
          <span style="font-size:16px; color:#000;">WhatsApp</span>
        </a>
      </div>
    </form>
  </main>

  <footer>
    <p>Whatsapp:+55 (77) 9 8814-8527</p><br>
    <p>&copy; 2025 ConquistaGuard. Todos os direitos reservados.</p>
  </footer>
  <script>
    function redirect() {
      window.location.href = '/'
    }
  </script>
  <style>
    textarea {
      resize: vertical;
      /* <-- aqui */
    }
    #faleConosco{
      margin-left: 10%;
    }
    @media (max-width:768px) {
      #faleConosco{
        margin-left: 0px;
      }
      #whatsapp{
        display: block;
        align-items: flex-start;
        justify-content: flex-start;
      }
    }
  </style>
</body>

</html>