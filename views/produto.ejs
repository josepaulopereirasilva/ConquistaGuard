<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />
  <title>
    <%= produto.nome %> - ConquistaGuard
  </title>
  <link rel="icon" href="/conquistaguard.ico" type="image/x-icon">
  <link rel="stylesheet" href="/style.css">
  <style>
    .produto-container {
      padding: 40px 20px;
      max-width: 600px;
      margin: 0 auto;
      text-align: center;
    }

    .produto-container img {
      width: 100%;
      max-height: 300px;
      object-fit: contain;
      border-radius: 10px;
    }

    .produto-container h1 {
      color: #ffcc00;
      font-size: 28px;
      margin-top: 20px;
    }

    .produto-container p {
      color: #757575;
      margin: 15px 0;
    }

    .produto-container strong {
      color: #ffcc00;
      font-size: 1.8em;
    }

    .produto-container button {
      margin-top: 20px;
      background-color: #ffcc00;
      color: #000;
      border: none;
      padding: 12px 25px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.3s;
      font-size: 32px;
      height: 100px;
      width: 400px;
    }

    .produto-container button:hover {
      background-color: #e6b800;
    }
  </style>
</head>

<body>
  
  <script src="https://sdk.mercadopago.com/js/v2"></script>
  <script>
    const mp = new MercadoPago('APP_USR-e7125dda-15ec-498d-a839-dd31e046a6fd', {
      locale: 'pt-BR'
    });

    async function comprarProduto() {
      try {
        const response = await fetch('/create_preference', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            title: '<%= produto.nome %>',
            price: Number(String('<%= produto.preco %>').replace('R$', '').replace('.', '').replace(',', '.')),
            quantity: 1
          })
        });

        const data = await response.json();

        if (data.id) {
          mp.checkout({
            preference: {
              id: data.id
            },
            autoOpen: true
          });
        } else {
          alert('Erro ao iniciar pagamento.');
        }
      } catch (error) {
        console.error('Erro:', error);
        alert('Erro ao conectar com o servidor.');
      }
    }
  </script>

  <header>
    <div class="logo" onclick="redirect()" style="cursor: pointer; display: inline-block;">
      <img src="/conquistaguard.ico" alt="ConquistaGuard Logo" style="height: 100px;">
    </div>
    <nav>
      <ul>
        <li><a href="/equipamentos">Equipamentos</a></li>
        <li><a href="/sobre">Sobre</a></li>
        <li><a href="/contato">Contato</a></li>
      </ul>
    </nav>
  </header>

  <main class="produto-container">
    <img src="<%= produto.img.startsWith('data:') ? produto.img : 'data:image/jpeg;base64,' + produto.img %>" alt="...">
    <h1>
      <%= produto.nome %>
    </h1>
    <strong>
      <p style="margin: 0; padding: 0; margin-bottom: -40px; color: #000; font-size: 64px;">
        <%= produto.preco %>
      </p>
    </strong>
    <br>
    <div>
      <button onclick="comprarProduto()">Comprar</button>
      <p style="margin-top: 20px; font-size: 16px; color: #333;">
    📲OBS: Favor enviar o comprovante para nosso WhatsApp assim que o pagamento for confirmado.
  </p>
   <a href="https://wa.me/5577988148527" target="_blank"
          style="display:inline-flex; align-items:center; gap:8px; margin-top:15px; text-decoration:none;">
          <img src="/whatsapp.png" alt="WhatsApp" style="width:30px; height:30px;">
          <span style="font-size:16px; color:#000;">WhatsApp</span>
        </a>
    </div>
    <h1>Descrição do Produto:</h1>
    <% produto.descricao.split('//enter').forEach(function(parte) { %>
      <p>
        <%= parte %>
      </p>
      <% }); %>
  </main>

  <footer>
    <p>&copy; 2025 ConquistaGuard. Todos os direitos reservados.</p>
  </footer>

  <script>

    function redirect() {
      window.location.href = '/';
    }
  </script>
  <style>
    body {
      background-color: white;
    }
  </style>
</body>

</html>