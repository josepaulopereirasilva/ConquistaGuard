generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model produtos {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  categoria String?
  estoque String?
  descricao String?
  img       String?
  nome      String? @unique
  preco     String?
}

model userAdmin{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  nome String @unique
  senha String @unique
}
